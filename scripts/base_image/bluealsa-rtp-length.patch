  * Get A2DP RTP header payload data.
  *
  * @param hdr The pointer to data with RTP header.
+ * @param len The number of bytes received at hdr.
+ * @param min_payload Bytes the caller reads right after the RTP header (its
+ *   media payload header), at least 1.
  * @return On success, this function returns pointer to data just after
- *   the RTP header - RTP header payload. On failure, NULL is returned. */
-void *rtp_a2dp_get_payload(const rtp_header_t *hdr) {
+ *   the RTP header - RTP header payload. On failure, including a packet too
+ *   short for its fixed header, CSRC list and min_payload bytes, NULL is
+ *   returned. */
+void *rtp_a2dp_get_payload(const rtp_header_t *hdr, size_t len, size_t min_payload) {
+
+	if (min_payload < 1)
+		min_payload = 1;
+	if (len < RTP_HEADER_LEN ||
+			len < RTP_HEADER_LEN + hdr->cc * sizeof(hdr->csrc[0]) + min_payload) {
+		warn("Truncated RTP packet: %zu bytes", len);
+		return NULL;
+	}
 
 #if ENABLE_PAYLOADCHECK
 	if (hdr->paytype < 96) {
