--- a/test/test-rtp.c	2026-08-26 22:46:51.000000000 -0600
+++ b/test/test-rtp.c	2026-09-26 01:35:30.325928919 -0600
@@ -48,15 +48,26 @@
 	uint8_t *payload;
 
 #if ENABLE_PAYLOADCHECK
-	payload = rtp_a2dp_get_payload(header);
+	payload = rtp_a2dp_get_payload(header, sizeof(buffer), 1);
 	ck_assert_ptr_eq(payload, NULL);
 #endif
 
 	header->paytype = 96;
-	payload = rtp_a2dp_get_payload(header);
+	payload = rtp_a2dp_get_payload(header, sizeof(buffer), 1);
 	ck_assert_ptr_ne(payload, NULL);
 	ck_assert_int_eq(payload[0], 12);
 
+	/* Too short for the fixed header, or for a single payload byte. */
+	ck_assert_ptr_eq(rtp_a2dp_get_payload(header, RTP_HEADER_LEN - 1, 1), NULL);
+	ck_assert_ptr_eq(rtp_a2dp_get_payload(header, RTP_HEADER_LEN, 1), NULL);
+	/* The CSRC list must fit inside the packet too. */
+	header->cc = 15;
+	ck_assert_ptr_eq(rtp_a2dp_get_payload(header, RTP_HEADER_LEN + 15 * 4, 1), NULL);
+	ck_assert_ptr_ne(rtp_a2dp_get_payload(header, RTP_HEADER_LEN + 15 * 4 + 1, 1), NULL);
+	/* A 4-byte media header (MPEG) must fit entirely. */
+	ck_assert_ptr_eq(rtp_a2dp_get_payload(header, RTP_HEADER_LEN + 15 * 4 + 3, 4), NULL);
+	ck_assert_ptr_ne(rtp_a2dp_get_payload(header, RTP_HEADER_LEN + 15 * 4 + 4, 4), NULL);
+
